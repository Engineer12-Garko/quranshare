# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/quranflow

# Secret key for session signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret

# Application environment: development | test | production
APP_ENV=development

# Google Drive service account JSON (full JSON string or path to file)
GOOGLE_SERVICE_ACCOUNT={}

# Root Google Drive folder ID that contains the category sub-folders
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-drive-folder-id-here

# Shared secret for the scheduled Drive sync endpoint.
# Sent by the GitHub Actions "Drive Sync" workflow (see .github/workflows/drive-sync.yml).
# Must match the repository secret CRON_SECRET configured in GitHub.
# VERCEL_CRON_SECRET is still accepted as a fallback name.
CRON_SECRET=generate-a-long-random-secret

# Cookie settings
# Set to true in production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# How many recent videos to exclude from daily reminder
RECENT_EXCLUSION_LIMIT=7

# Optional Quran Foundation Content API credentials.
# Create an application in the Quran Foundation Developer Console.
# Keep client ID and secret matched to the selected environment.
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# prelive | production; new Developer Console apps start in prelive.
QF_ENV=prelive
# Translation resource available in Prelive (M.A.S. Abdel Haleem).
# Production may use 131 (Dr. Mustafa Khattab, the Clear Quran) if desired.
QF_TRANSLATION_ID=85
